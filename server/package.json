{
  "name": "meditrack-server",
  "version": "1.0.0",
  "type": "module",
  "description": "MediTrack Express Backend API",
  "main": "src/index.js",
  "scripts": {
    "server": "node --watch src/index.js",
    "start": "node src/index.js",
    "postinstall": "prisma generate && prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.js",
    "migrate:self-cards": "node scripts/migrateExistingUsers.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/adapter-pg": "^6.3.1",
    "@prisma/client": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "google-auth-library": "^9.0.0",
    "imagekit": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.11.3",
    "sharp": "^0.34.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "prisma": "^7.0.1"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
